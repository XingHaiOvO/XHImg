{
  "name": "@xhimg/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:scale": "tsx test/scale.ts",
    "test:resources": "tsx test/resources.ts",
    "test:migration-scale": "tsx test/migration-scale.ts",
    "backup": "tsx --env-file-if-exists=../../.env src/backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.5.2",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
